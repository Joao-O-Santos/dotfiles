# Ignore everything by default
/*
*.gpg
R/rsconnect

# Track these dirs/files:
!/firefox
!.gitignore
!/git
!/i3
!/i3status
!/LICENSES
!/link_configs.sh
!/pandoc
!/R
!/mimeapps.list
!/nvim/init.vim
!/playlist.m3u
!/profile
!/scripts
!/shellrc
!/environment.d
!/xorg/xinitrc
!/wallpapers/WALLPAPERS_GO_HERE
# Track Pi's secret-free private overlay
!/pi
/pi/auth.json
/pi/pi-sych/worker-agent/*
/pi/secrets.env
!/pi/secrets.env.example
/pi/models-store.json
/pi/npm/
/pi/git/
/pi/trust.json
/pi/*.secrets.json
/pi/*.secrets.jsonc
/pi/.env
/pi/.env.*
!/pi/.env.example
/pi/sessions/
/pi/runtime/
/pi/worker-agent/
/pi/mcp-*.json

# Track the secret-free shared MCP configuration.
!/mcp/
!/mcp/mcp.json
!/mcp/README.md

*.secret
*.key
!.env.example

# --- NEVER commit secrets, credentials, or environment files ---
*.env
*.ENV
*.Env
*.env.*
.envrc
*.pwd
*.secret
*.SECRET
*.key
*.KEY
*.pem
*.pem.*
*.crt
*.cer
credentials*
secrets*
*.token
*.TOKEN

# Exception: example files are safe
!.env.example
!.env.sample
!/pi/secrets.env.example
