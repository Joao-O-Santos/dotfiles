# Ignore everything by default
/*
*.gpg
R/rsconnect

# Track these dirs/files:
!/firefox
!.gitignore
!/git
!/i3
!/i3status
!/LICENSES
!/link_configs.sh
!/pandoc
!/R
!/mimeapps.list
!/nvim/init.vim
!/playlist.m3u
!/profile
!/scripts
!/shellrc
!/xorg/xinitrc
!/wallpapers/WALLPAPERS_GO_HERE
# Track Pi's secret-free private overlay
!/pi
/pi/auth.json
/pi/models-store.json
/pi/npm/
/pi/git/
/pi/trust.json
/pi/*.secrets.json
/pi/*.secrets.jsonc
/pi/.env
/pi/.env.*
!/pi/.env.example
/pi/sessions/
/pi/runtime/
/pi/worker-agent/

# Track OpenCode
!/opencode
!/opencode/.gitignore
!/opencode/opencode.json
!/opencode/style
!/opencode/agents
!/opencode/skills
# Ignore OpenCode internal state
/opencode/auth.json
/opencode/account.json
/opencode/mcp_keys.sh
/opencode/opencode.db*
/opencode/node_modules
/opencode/snapshot
/opencode/log
/opencode/logs
/opencode/tool-output
/opencode/storage
/opencode/bun.lock
/opencode/package.json
/opencode/package-lock.json
/opencode/tui.json
/opencode/checkpoints/
opencode/mcp_keys.env
opencode/mcp-auth.json

*.secret
*.key
!.env.example

# --- NEVER commit secrets, credentials, or environment files ---
*.env
*.ENV
*.Env
*.env.*
.envrc
*.pwd
*.secret
*.SECRET
*.key
*.KEY
*.pem
*.pem.*
*.crt
*.cer
credentials*
secrets*
*.token
*.TOKEN

# Exception: example files are safe
!.env.example
!.env.sample
