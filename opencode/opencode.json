{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "${HOME}/.config/opencode/AGENTS.md"
  ],
  "default_agent": "planner",
  "references": {
    "style": {
      "path": "${HOME}/.config/opencode/STYLE.md",
      "description": "Complete shared writing and formatting conventions. The 5 core rules are already inlined via the style-core snippet in relevant skills — consult this only for full detail beyond those (Gold/Silver/Bronze hierarchy, OpenXML page-break syntax, custom Pandoc styles for Word conversion)."
    },
    "coding-style": {
      "path": "${HOME}/.config/opencode/skills/r-analysis-quarto/coding_style.md",
      "description": "Full R coding style reference: tab/space conventions, function length limits, lintr exceptions to ignore. Supplements the summary already in r-analysis-quarto/SKILL.md — consult for edge cases the summary does not cover.",
      "hidden": true
    },
    "lit-index": {
      "path": "~/lit",
      "description": "Local bibliography index (SQLite, file: _index.db). Query with sqlite3 ~/lit/_index.db '<SQL>' — do NOT attempt to read or cat this file directly, it is binary and will not render as text. Check here before marking a citation as <!-- TODO: cite -->, to see whether the reference already exists in the user's library.",
      "hidden": true
    }
  },
  "permission": {
    "bash": {
      "*": "deny",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "tso *": "allow",
      "chkdrft *": "allow",
      "toc *": "allow",
      "pdftotext *": "allow",
      "pdfgrep *": "allow",
      "sqlite3 *": "allow"
    },
    "external_directory": {
      "${HOME}/.config/opencode/**": "allow",
      "${HOME}/.config/opencode/auth.json": "deny",
      "${HOME}/.config/opencode/account.json": "deny",
      "${HOME}/.config/opencode/mcp_keys.sh": "deny",
      "${HOME}/lit/**": "allow",
      "/tmp/**": "allow"
    },
    "read": {
      "${HOME}/.config/opencode/**": "allow",
      "${HOME}/.config/opencode/auth.json": "deny",
      "${HOME}/.config/opencode/account.json": "deny",
      "${HOME}/.config/opencode/mcp_keys.sh": "deny",
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ]
    },
    "citecheck": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@jhlee0619/citecheck@latest"
      ],
      "environment": {
        "CROSSREF_MAILTO": "{env:CROSSREF_MAILTO}"
      }
    },
    "openalex": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@cyanheads/openalex-mcp-server@latest"
      ],
      "environment": {
        "OPENALEX_API_KEY": "{env:OPENALEX_API_KEY}",
        "OPENALEX_EMAIL": "{env:OPENALEX_EMAIL}"
      }
    },
    "semantic-scholar": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "paperplain-mcp@latest"
      ]
    }
  },
  "agent": {
    "planner": {
      "description": "Primary orchestrator and default agent",
      "mode": "primary",
      "model": "{env:PLANNER_MODEL}",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "task": {
          "*": "allow"
        }
      }
    },
    "automation": {
      "description": "Shell, git, and terminal-native execution",
      "mode": "primary",
      "model": "{env:AUTOMATION_MODEL}",
      "temperature": 0.3,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "allow",
          "git commit *": "ask",
          "git merge *": "ask",
          "git reset --hard *": "ask",
          "git clean *": "ask",
          "rm *": "ask",
          "chmod 777 *": "ask",
          "git push *": "deny",
          "sudo *": "deny",
          "yay -S *": "deny",
          "pacman -S *": "deny",
          "rm -rf /": "deny",
          "rm -rf ~": "deny",
          "dd *": "deny",
          "mkfs *": "deny",
          "fdisk *": "deny"
        }
      }
    },
    "writer": {
      "description": "Unified manuscript drafting (empirical/theoretical)",
      "mode": "primary",
      "model": "{env:WRITER_MODEL}",
      "steps": 20,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "ls *": "allow",
          "wc *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "sed *": "allow",
          "tso *": "allow",
          "chkdrft *": "allow",
          "toc *": "allow"
        }
      }
    },
    "reviewer-structure": {
      "description": "Big-picture critique: structure, arguments, impact",
      "mode": "subagent",
      "model": "{env:REVIEWER_STRUCTURE_MODEL}",
      "temperature": 0.8,
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      },
      "steps": 10
    },
    "reviewer-structure-2": {
      "description": "Adversarial second-opinion structural critique (checkpoints only)",
      "mode": "subagent",
      "model": "{env:REVIEWER_STRUCTURE_2_MODEL}",
      "temperature": 0.6,
      "steps": 10,
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "reviewer-detail": {
      "description": "Detail critique: citations, conceptual clarity, argument issues",
      "mode": "subagent",
      "model": "{env:REVIEWER_DETAIL_MODEL}",
      "temperature": 0.5,
      "steps": 10,
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "copyeditor": {
      "description": "Prose review: titles, paragraphs, sentences, words, markdown compliance",
      "mode": "subagent",
      "model": "{env:COPYEDITOR_MODEL}",
      "temperature": 0.4,
      "steps": 10,
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "editor": {
      "description": "Manuscript review collation agent: sorts reviewer output chronologically",
      "mode": "subagent",
      "model": "{env:EDITOR_MODEL}",
      "temperature": 0.3,
      "steps": 8,
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "strategist": {
      "description": "Gated arbitration for non-obvious or disputed fixes — tool-less, single-turn, batched per checkpoint",
      "mode": "subagent",
      "model": "{env:STRATEGIST_MODEL}",
      "temperature": 0.3,
      "steps": 1,
      "permission": {
        "edit": "deny",
        "read": "deny",
        "webfetch": "deny",
        "bash": { "*": "deny" }
      }
    },
    "literature-reviewer": {
      "description": "Fast academic search and paper summaries",
      "mode": "subagent",
      "model": "{env:LITERATURE_REVIEWER_MODEL}",
      "steps": 12,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "pdftotext *": "allow",
          "pdfgrep *": "allow",
          "sqlite3 *": "allow"
        }
      }
    },
    "deep-research": {
      "description": "Exhaustive multi-step research",
      "mode": "subagent",
      "model": "{env:DEEP_RESEARCH_MODEL}",
      "temperature": 0.5,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "pdftotext *": "allow",
          "pdfgrep *": "allow",
          "sqlite3 *": "allow"
        }
      }
    },
    "r-analysis": {
      "description": "R/Quarto pipeline coding and editing",
      "mode": "primary",
      "model": "{env:R_ANALYSIS_MODEL}",
      "temperature": 0.2,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "allow",
          "git commit *": "ask",
          "git merge *": "ask",
          "git reset --hard *": "ask",
          "git clean *": "ask",
          "rm *": "ask",
          "git push *": "deny",
          "sudo *": "deny",
          "chmod 777 *": "deny",
          "yay -S *": "deny",
          "pacman -S *": "deny",
          "rm -rf /": "deny",
          "rm -rf ~": "deny",
          "dd *": "deny",
          "mkfs *": "deny",
          "fdisk *": "deny"
        }
      }
    }
  },
  "plugin": [
    "opencode-snippets",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@latest",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan",
          "planner"
        ]
      }
    ]
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}
