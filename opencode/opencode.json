{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "${HOME}/.config/opencode/AGENTS.md"
  ],
  "default_agent": "planner",
  "references": {
    "style": {
      "path": "${HOME}/.config/opencode/STYLE.md",
      "description": "Complete shared writing and formatting conventions. The 5 core rules are already inlined via the style-core snippet in relevant skills \u2014 consult this only for full detail beyond those (Gold/Silver/Bronze hierarchy, OpenXML page-break syntax, custom Pandoc styles for Word conversion)."
    },
    "lit-index": {
      "path": "~/lit",
      "description": "Local bibliography index (SQLite, file: _index.db). Query with sqlite3 ~/lit/_index.db '<SQL>' \u2014 do NOT attempt to read or cat this file directly, it is binary and will not render as text. Check here before marking a citation as <!-- TODO: cite -->, to see whether the reference already exists in the user's library.",
      "hidden": true
    },
    "r-style": {
      "path": "${HOME}/.config/opencode/skills/r-analysis-quarto",
      "description": "R/Quarto pipeline reference: SKILL.md, coding style, and example scripts",
      "hidden": true
    },
    "writing-examples": {
      "path": "${HOME}/.config/opencode/writing-examples",
      "description": "Worked writing examples organized by section type (intro, methods, results, discussion, abstract). Use when drafting or revising to see exemplary prose from published papers and the user's own work.",
      "hidden": true
    }
  },
  "permission": {
    "bash": {
      "*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "${HOME}/.config/opencode/auth.json": "deny",
      "${HOME}/.config/opencode/account.json": "deny",
      "${HOME}/.config/opencode/mcp_keys.env": "deny"
    },
    "external_directory": {
      "${HOME}/.config/opencode/**": "allow",
      "${HOME}/lit/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ]
    },
    "citecheck": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@jhlee0619/citecheck@latest"
      ],
      "environment": {
        "CROSSREF_MAILTO": "{env:CROSSREF_MAILTO}"
      }
    },
    "openalex": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@cyanheads/openalex-mcp-server@latest"
      ],
      "environment": {
        "OPENALEX_API_KEY": "{env:OPENALEX_API_KEY}",
        "OPENALEX_EMAIL": "{env:OPENALEX_EMAIL}"
      }
    },
    "semantic-scholar": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "paperplain-mcp@latest"
      ]
    },
    "scholar-gateway": {
      "type": "remote",
      "url": "https://connector.scholargateway.ai/mcp",
      "enabled": true
    }
  },
  "agent": {
    "planner": {
      "description": "Primary orchestrator and default agent",
      "mode": "primary",
      "model": "{env:PLANNER_MODEL}",
      "variant": "high",
      "textVerbosity": "low",
      "permission": {
        "task": "allow",
        "webfetch": "allow",
        "question": "allow"
      }
    },
    "automation": {
      "description": "Shell, git, and terminal-native execution",
      "mode": "primary",
      "model": "{env:AUTOMATION_MODEL}",
      "variant": "low",
      "textVerbosity": "low",
      "temperature": 0.3,
      "steps": 30,
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "bash": {
          "*": "allow",
          "git commit *": "allow",
          "git merge *": "ask",
          "git reset --hard *": "ask",
          "git clean *": "ask",
          "rm *": "ask",
          "chmod 777 *": "ask",
          "git push *": "deny",
          "sudo *": "deny",
          "yay -S *": "deny",
          "pacman -S *": "deny",
          "rm -rf /": "deny",
          "rm -rf ~": "deny",
          "dd *": "deny",
          "mkfs *": "deny",
          "fdisk *": "deny"
        }
      }
    },
    "writer": {
      "description": "Unified manuscript drafting (empirical/theoretical)",
      "mode": "primary",
      "model": "{env:WRITER_MODEL}",
      "variant": "low",
      "steps": 20,
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "edit": "allow"
      }
    },
    "reviewer-structure": {
      "description": "Big-picture critique: structure, arguments, impact",
      "mode": "subagent",
      "model": "{env:REVIEWER_STRUCTURE_MODEL}",
      "variant": "high",
      "textVerbosity": "low",
      "temperature": 0.8,
      "steps": 10,
      "permission": {
        "edit": "deny"
      }
    },
    "reviewer-structure-2": {
      "description": "Adversarial second-opinion structural critique (checkpoints only)",
      "mode": "subagent",
      "model": "{env:REVIEWER_STRUCTURE_2_MODEL}",
      "variant": "high",
      "textVerbosity": "low",
      "temperature": 0.6,
      "steps": 10,
      "permission": {
        "edit": "deny"
      }
    },
    "reviewer-detail": {
      "description": "Detail critique: citations, conceptual clarity, argument issues",
      "mode": "subagent",
      "model": "{env:REVIEWER_DETAIL_MODEL}",
      "variant": "medium",
      "textVerbosity": "low",
      "temperature": 0.5,
      "steps": 10,
      "permission": {
        "edit": "deny"
      }
    },
    "copyeditor": {
      "description": "Prose review: titles, paragraphs, sentences, words, markdown compliance",
      "mode": "subagent",
      "model": "{env:COPYEDITOR_MODEL}",
      "variant": "low",
      "textVerbosity": "low",
      "temperature": 0.4,
      "steps": 10,
      "permission": {
        "edit": "deny"
      }
    },
    "editor": {
      "description": "Manuscript review collation agent: categorizes reviewer output by consensus level",
      "mode": "subagent",
      "model": "{env:EDITOR_MODEL}",
      "variant": "low",
      "textVerbosity": "low",
      "temperature": 0.5,
      "steps": 10,
      "permission": {
        "edit": "deny"
      }
    },
    "strategist": {
      "description": "Gated arbitration for non-obvious or disputed fixes \u2014 tool-less, single-turn, batched per checkpoint",
      "mode": "subagent",
      "model": "{env:STRATEGIST_MODEL}",
      "variant": "high",
      "textVerbosity": "low",
      "temperature": 0.3,
      "steps": 3,
      "permission": {
        "edit": "deny"
      }
    },
    "literature-reviewer": {
      "description": "Fast academic search and paper summaries",
      "mode": "subagent",
      "model": "{env:LITERATURE_REVIEWER_MODEL}",
      "variant": "low",
      "textVerbosity": "low",
      "steps": 20,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "deny",
          "pdftotext *": "allow",
          "pdfgrep *": "allow",
          "sqlite3 *": "allow"
        }
      }
    },
    "deep-research": {
      "description": "Exhaustive multi-step research",
      "mode": "subagent",
      "model": "{env:DEEP_RESEARCH_MODEL}",
      "variant": "medium",
      "temperature": 0.5,
      "steps": 30,
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "deny",
          "pdftotext *": "allow",
          "pdfgrep *": "allow",
          "sqlite3 *": "allow"
        }
      }
    },
    "r-coder": {
      "description": "R/Quarto pipeline coding and editing",
      "mode": "primary",
      "model": "{env:R_CODER_MODEL}",
      "variant": "medium",
      "textVerbosity": "low",
      "temperature": 0.2,
      "steps": 30,
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "edit": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "*": "allow",
          "git commit *": "ask",
          "git merge *": "ask",
          "git reset --hard *": "ask",
          "git clean *": "ask",
          "rm *": "ask",
          "git push *": "deny",
          "sudo *": "deny",
          "chmod 777 *": "deny",
          "yay -S *": "deny",
          "pacman -S *": "deny",
          "rm -rf /": "deny",
          "rm -rf ~": "deny",
          "dd *": "deny",
          "mkfs *": "deny",
          "fdisk *": "deny"
        }
      }
    }
  },
  "plugin": [
    "opencode-snippets",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@latest",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan",
          "planner"
        ]
      }
    ]
  ],
  "compaction": {
    "auto": false,
    "prune": false
  }
}
