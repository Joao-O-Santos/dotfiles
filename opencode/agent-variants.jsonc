{
  "models": {
    "structural-fast": { "model": "openai/gpt-5.6-luna", "variant": "medium", "temperature": 0.8 },
    "structural-adversarial": { "model": "openai/gpt-5.6-sol", "variant": "high", "temperature": 0.6 }
  },
  "agents": {
    "reviewer-structure": {
      "variants": {
        "fast": { "name": "reviewer-structure-fast", "model": "structural-fast", "description": "Routine Fast Loop structural review using the structural reviewer workflow." },
        "adversarial": { "name": "reviewer-structure-2", "model": "structural-adversarial", "description": "Adversarial structural review for Full Ensemble Checkpoints; output is for editor collation.", "prompt_append": "\n\nUse a skeptical, less charitable posture. Probe overclaiming, missing counterfactuals, and alternative explanations. Diagnose issues but never suggest fixes. Flag only genuine issues. This is checkpoint-only; output goes to editor for collation." }
      }
    }
  }
}
