{
  "$schema": "https://raw.githubusercontent.com/cortexkit/opencode-magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "historian": {
    "model": "openai/gpt-5.6-terra"
  },
  "dreamer": {
    "model": "openai/gpt-5.6-terra",
    "tasks": {
      "verify": {
        "schedule": "0 2 * * *"
      },
      "verify-broad": {
        "schedule": "0 4 * * 0"
      },
      "curate": {
        "schedule": "0 2 * * *"
      },
      "classify-memories": {
        "schedule": "0 6 * * *"
      },
      "retrospective": {
        "schedule": "0 5 * * *"
      },
      "maintain-docs": {
        "schedule": "0 7 * * 0"
      },
      "map-memories": {
        "schedule": "0 2 * * *"
      },
      "evaluate-smart-notes": {
        "schedule": "0 2 * * *"
      },
      "review-user-memories": {
        "schedule": "0 2 * * *"
      }
    },
    "inject_docs": true
  },
  "memory": {
    "enabled": true,
    "git_commit_indexing": {
      "enabled": true
    }
  },
  "sidekick": {
    "model": "openai/gpt-5.6-luna"
  }
}
